{
  "realm": "relsynth",
  "enabled": true,
  "sslRequired": "external",
  "accessTokenLifespan": 600,
  "ssoSessionIdleTimeout": 1800,
  "bruteForceProtected": true,
  "passwordPolicy": "length(12) and notUsername",
  "roles": {
    "realm": [
      {
        "name": "*:platform_admin",
        "description": "relsynth role (tenant:role)"
      },
      {
        "name": "acme:consumer",
        "description": "relsynth role (tenant:role)"
      },
      {
        "name": "acme:data_owner",
        "description": "relsynth role (tenant:role)"
      },
      {
        "name": "acme:engineer",
        "description": "relsynth role (tenant:role)"
      },
      {
        "name": "acme:privacy_officer",
        "description": "relsynth role (tenant:role)"
      },
      {
        "name": "acme:tenant_admin",
        "description": "relsynth role (tenant:role)"
      },
      {
        "name": "beta:data_owner",
        "description": "relsynth role (tenant:role)"
      },
      {
        "name": "beta:engineer",
        "description": "relsynth role (tenant:role)"
      },
      {
        "name": "beta:privacy_officer",
        "description": "relsynth role (tenant:role)"
      },
      {
        "name": "beta:tenant_admin",
        "description": "relsynth role (tenant:role)"
      }
    ]
  },
  "clients": [
    {
      "clientId": "relsynth-ui",
      "name": "relsynth web UI",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://localhost:8080/ui/*"
      ],
      "webOrigins": [
        "http://localhost:8080"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8080/ui/*"
      },
      "protocolMappers": [
        {
          "name": "relsynth roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "relsynth_roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "relsynth audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "relsynth",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "relsynth-e2e",
      "name": "end-to-end tests only: delete in production",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "relsynth roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "relsynth_roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "relsynth audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "relsynth",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    }
  ],
