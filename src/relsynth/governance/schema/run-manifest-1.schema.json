{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nick-developer/relsynth/run-manifest/1",
  "title": "relsynth run manifest",
  "description": "An in-toto Statement v1 whose predicate records one relsynth run: what was read (a fingerprint, never data), the spec and IR, versions, seeds of non-private stages, the privacy guarantee and its ledger entry, the reports and the policy decision. It is signed in a DSSE envelope and appended to the registry's hash-chained log. Approvals are separate signed statements that name this manifest's digest. Design: docs/governance/design.md, section 6.",
  "type": "object",
  "required": ["_type", "subject", "predicateType", "predicate"],
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "digest": {"type": "object", "required": ["sha256"], "properties": {"sha256": {"$ref": "#/$defs/sha256"}}},
    "time": {"type": "string", "format": "date-time"},
    "charge": {
      "type": "object",
      "required": ["stage", "kind"],
      "additionalProperties": false,
      "description": "One DP mechanism's guarantee as the DP engine (T07) reports it, w.r.t. the domain's unit and adjacency. Numbers are decimal strings so that hashing is exact.",
      "properties": {
        "stage": {"enum": ["discovery", "fit", "selection", "evaluation", "other"]},
        "mechanism": {"type": "string"},
        "kind": {"enum": ["pure", "zcdp", "approx"]},
        "epsilon": {"type": "string"},
        "rho": {"type": "string"},
        "delta": {"type": "string"}
      }
    },
    "report": {
      "type": "object",
      "required": ["kind", "schema", "digest", "external_safe"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["quality", "privacy", "model", "dp_statement", "other"]},
        "schema": {"type": "string", "description": "e.g. relsynth.privacy-report/1, quality-report-2.0"},
        "digest": {"$ref": "#/$defs/digest"},
        "uri": {"type": "string"},
        "external_safe": {"type": "boolean", "description": "True only for artefacts computed from public facts or charged to the budget; only these may go into an external release package."}
      }
    }
  },
  "properties": {
    "_type": {"const": "https://in-toto.io/Statement/v1"},
    "subject": {
      "type": "array", "minItems": 1,
      "description": "The synthetic outputs: one entry per table file or table, with the digest of its canonical export.",
      "items": {"type": "object", "required": ["name", "digest"], "additionalProperties": false,
                "properties": {"name": {"type": "string"}, "digest": {"$ref": "#/$defs/digest"}}}
    },
    "predicateType": {"const": "https://github.com/nick-developer/relsynth/run-manifest/1"},
    "predicate": {
      "type": "object",
      "required": ["run", "source", "spec", "software", "privacy", "reports", "policy", "release"],
      "additionalProperties": false,
      "properties": {
        "run": {
          "type": "object", "required": ["id", "started", "finished", "operator", "command"], "additionalProperties": false,
          "properties": {
            "id": {"type": "string", "description": "ULID of the run."},
            "parent": {"type": "string", "description": "Run this one re-releases or refines."},
            "started": {"$ref": "#/$defs/time"}, "finished": {"$ref": "#/$defs/time"},
            "operator": {"type": "object", "required": ["name", "key"], "additionalProperties": false,
                         "properties": {"name": {"type": "string"}, "key": {"type": "string", "description": "Fingerprint of the operator's signing key (T09 maps it to an identity)."}}},
            "command": {"type": "string", "description": "CLI command or API call, credentials removed."}
          }
        },
        "source": {
          "type": "object", "required": ["id", "domain", "fingerprint"], "additionalProperties": false,
          "description": "What was read, without data: no values, no row counts, no category levels.",
          "properties": {
            "id": {"type": "string", "description": "Source id from the organisation policy."},
            "domain": {"type": "string"},
            "fingerprint": {"type": "object", "required": ["locator_hmac", "schema_sha256"], "additionalProperties": false,
                            "properties": {
                              "locator_hmac": {"$ref": "#/$defs/sha256", "description": "HMAC-SHA256 of the connection locator without credentials, keyed with the registry secret, so that two runs on one source match without revealing hosts."},
                              "schema_sha256": {"$ref": "#/$defs/sha256", "description": "Hash of the source's table and column names and types (IR structure only)."},
                              "snapshot": {"type": "string", "description": "Optional snapshot or transaction id reported by the source."}}}
          }
        },
        "spec": {
          "type": "object", "required": ["digest", "ir_digest", "ir_version"], "additionalProperties": false,
          "properties": {"digest": {"$ref": "#/$defs/digest"}, "ir_digest": {"$ref": "#/$defs/digest"}, "ir_version": {"type": "string"},
                         "public_facts_only": {"type": "boolean", "description": "True when every spec value used by a DP run came from public schema facts or was charged (T07)."}}
        },
        "software": {
          "type": "object", "required": ["relsynth"], "additionalProperties": false,
          "properties": {"relsynth": {"type": "string"},
                         "plugins": {"type": "array", "items": {"type": "object", "required": ["name", "version"], "properties": {"name": {"type": "string"}, "version": {"type": "string"}, "digest": {"$ref": "#/$defs/digest"}}}},
                         "accountant": {"type": "string", "description": "e.g. opendp 0.12.1"},
                         "python": {"type": "string"}, "platform": {"type": "string"}}
        },
        "seeds": {
          "type": "object", "additionalProperties": false,
          "description": "Seeds of stages that are not differentially private. DP noise is drawn from the operating system's CSPRNG and is never seeded or recorded.",
          "properties": {"generator": {"type": "integer"}, "assessment_split": {"type": "integer"}}
        },
        "privacy": {
          "type": "object", "required": ["mode"], "additionalProperties": false,
          "properties": {
            "mode": {"enum": ["dp", "none"]},
            "unit": {"type": "string"}, "adjacency": {"enum": ["add_remove", "replace"]},
            "charges": {"type": "array", "items": {"$ref": "#/$defs/charge"}},
            "run_total": {"type": "object", "required": ["rho", "delta"], "additionalProperties": false,
                          "properties": {"rho": {"type": "string"}, "delta": {"type": "string"}}},
            "stated": {"type": "object", "required": ["epsilon", "delta"], "additionalProperties": false,
                       "description": "(epsilon, delta) of this release alone at the domain's delta (Prop. 800).",
                       "properties": {"epsilon": {"type": "string"}, "delta": {"type": "string"}}},
            "ledger": {"type": "object", "required": ["seq", "domain_rho", "domain_delta", "domain_epsilon"], "additionalProperties": false,
                       "description": "The ledger entry that settled this run and the domain's cumulative guarantee after it.",
                       "properties": {"seq": {"type": "integer"}, "domain_rho": {"type": "string"}, "domain_delta": {"type": "string"}, "domain_epsilon": {"type": "string"}}}
          },
          "allOf": [{"if": {"properties": {"mode": {"const": "dp"}}},
                     "then": {"required": ["unit", "adjacency", "charges", "run_total", "stated", "ledger"]}}]
        },
        "reports": {"type": "array", "items": {"$ref": "#/$defs/report"}},
        "verdicts": {"type": "object", "additionalProperties": {"enum": ["pass", "review", "fail", "blocked"]},
                     "description": "T06 verdict per release context."},
        "policy": {
          "type": "object", "required": ["digest", "version", "decisions"], "additionalProperties": false,
          "properties": {
            "digest": {"$ref": "#/$defs/digest"}, "version": {"type": "string"}, "engine": {"type": "string"},
            "decisions": {"type": "object", "additionalProperties": {
              "type": "object", "required": ["allow", "reasons"], "additionalProperties": false,
              "properties": {"allow": {"type": "boolean"}, "approval_required": {"type": "boolean"},
                             "reasons": {"type": "array", "items": {"type": "string"}}}}}
          }
        },
        "release": {
          "type": "object", "required": ["context", "target"], "additionalProperties": false,
          "description": "The intended release. The release itself happens only after the approvals the policy requires are in the registry.",
          "properties": {"context": {"type": "string"}, "target": {"type": "string"}}
        },
        "chain": {
          "type": "object", "required": ["prev"], "additionalProperties": false,
          "description": "Hash of the registry log head when the manifest was made (Prop. 803).",
          "properties": {"prev": {"$ref": "#/$defs/sha256"}}
        }
      }
    }
  }
}
